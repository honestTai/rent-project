# Reference only: install generates the private .env automatically.
# External MySQL requires VERIFY_IDENTITY and its real, TLS-matching hostname.
DB_MODE=managed
RDS_HOST=mysql
RDS_PORT=3306
RDS_USERNAME=rent_app
RDS_PASSWORD=
RDS_PLATFORM_DATABASE=equipment_platform
RDS_ALIPAY_DATABASE=equipment_alipay
REDIS_PASSWORD=
MYSQL_ROOT_PASSWORD=
DB_SSL_MODE=DISABLED
DB_SSL_CA=
DB_JDBC_OPTIONS=
JAVA_OPTS_EUREKA=-Xms96m -Xmx192m -XX:MaxMetaspaceSize=128m -XX:+ExitOnOutOfMemoryError
JAVA_OPTS_PLATFORM=-Xms160m -Xmx384m -XX:MaxMetaspaceSize=160m -XX:+ExitOnOutOfMemoryError
JAVA_OPTS_ALIPAY=-Xms192m -Xmx512m -XX:MaxMetaspaceSize=192m -XX:+ExitOnOutOfMemoryError
JAVA_OPTS_GATEWAY=-Xms160m -Xmx384m -XX:MaxMetaspaceSize=160m -XX:+ExitOnOutOfMemoryError

# Generate independent random secrets for this deployment; keep stable after initialization.
RENTAL_PRODUCT_AES_SECRET=
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
