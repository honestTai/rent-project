RDS_HOST=mysql.example.com
RDS_PORT=3306
RDS_USERNAME=change_this_rds_username
RDS_PASSWORD=change_this_rds_password
RDS_PLATFORM_DATABASE=equipment_platform
RDS_ALIPAY_DATABASE=equipment_alipay
REDIS_PASSWORD=change_this_redis_password
JAVA_OPTS_EUREKA=-Xms96m -Xmx192m -XX:MaxMetaspaceSize=96m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError
JAVA_OPTS_PLATFORM=-Xms160m -Xmx384m -XX:MaxMetaspaceSize=128m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError
JAVA_OPTS_ALIPAY=-Xms192m -Xmx512m -XX:MaxMetaspaceSize=160m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError -Deureka.client.service-url.defaultZone=http://equipment-eureka:8761/eureka/
JAVA_OPTS_GATEWAY=-Xms160m -Xmx384m -XX:MaxMetaspaceSize=128m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError

# Generate independent random secrets for this deployment; keep stable after initialization.
RENTAL_PRODUCT_AES_SECRET=
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
